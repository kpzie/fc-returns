# Server-only. Never prefix these with NEXT_PUBLIC_.
# With none of them set, `npm run dev` runs without login as dev@localhost (both roles), storing in ./.data.
# Production refuses to start unless all three are set.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
# Used only to insert a validated upload; every read and submission runs as the signed-in user under RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: run test/supabase-live.test.ts against a DEDICATED TEST project (never production).
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
